# ---------------------------------------------------------------------------
# Dentistry Printing — environment variables
#
# Copy to .env for local development. Never commit a filled-in copy.
# On Railway, set these in the service's Variables tab.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Railway: add a PostgreSQL service and reference its connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# --- Authentication (required) ---------------------------------------------
# Signs session tokens, the confirmation cookie, and the keyed hashes used for
# rate limiting. Must be at least 32 characters.
#   generate with: openssl rand -base64 48
AUTH_SECRET=""

# The public origin, used by Auth.js to build callback URLs.
#   local:   http://localhost:3000
#   Railway: https://your-service.up.railway.app
AUTH_URL="http://localhost:3000"

# --- Transactional email (optional; quote requests save without it) ---------
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=""

# Verified sender. The domain must be verified in Resend before delivery works.
QUOTE_FROM_EMAIL="Dentistry Printing <quotes@yourdomain.com>"

# Where new quote notifications go. Your own address.
QUOTE_NOTIFICATION_EMAIL=""

# --- Abuse protection (optional) -------------------------------------------
# Quote submissions allowed from one IP address per window.
# QUOTE_RATE_LIMIT_MAX="5"
# QUOTE_RATE_LIMIT_WINDOW_MINUTES="30"
#
# Failed sign-in attempts allowed per window before lockout. Counted per
# account and per IP address, so neither a single-account attack nor a spray
# across many accounts gets an unlimited number of guesses.
# LOGIN_RATE_LIMIT_PER_EMAIL="5"
# LOGIN_RATE_LIMIT_PER_IP="20"
# LOGIN_RATE_LIMIT_WINDOW_MINUTES="15"

# --- Testing only ----------------------------------------------------------
# "capture" writes emails to EMAIL_CAPTURE_DIR instead of sending them.
# Leave unset in production.
# EMAIL_TRANSPORT="capture"
# EMAIL_CAPTURE_DIR=".mail-outbox"
